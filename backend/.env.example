PORT=4000
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
CLIENT_ORIGIN=http://localhost:5173

# --- Required. The app will not start without a reachable Postgres. ---
# Fastest path: `docker compose up -d postgres` from the project root, then
# leave this as-is. Otherwise point it at your own Postgres instance.
DATABASE_URL=postgres://medifinder:medifinder@localhost:5432/medifinder

UPLOAD_DIR=./uploads

# --- Optional services below. Each is OFF by default with a safe dev-mode
# fallback - the app runs fully without them. ---

# MongoDB - mirrors report metadata & reviews if set. Leave blank to skip.
MONGODB_URI=

# Redis - caches comparison results + rate-limits login attempts if set.
# Leave blank to skip caching/rate-limiting (safe for local dev).
REDIS_URL=

# Razorpay - get free TEST MODE keys in ~5 minutes at https://dashboard.razorpay.com/signup
# (no business registration needed for test mode). Test card: 4111 1111 1111 1111,
# any future expiry, any CVV. Leave blank to auto-confirm bookings in "simulated payment" mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# SMTP (email) - real emails sent if all four are set. Leave blank to just
# log the email content to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MediFinder <no-reply@medifinder.app>

# Twilio - real SMS sent if all three are set. Leave blank to log to console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# WhatsApp via Twilio's WhatsApp API - real messages sent if set (in addition
# to the Twilio vars above). Leave blank to log to console.
TWILIO_WHATSAPP_FROM=
